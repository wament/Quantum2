{
  "models": [
    {
      "title": "Qwen3.6 Local",
      "model":"Qwen3.6-27B-Fable-Fus-711-UnHeretic-NM-DAU-NEO-MAX-NEO-MTP-Q4_K_M",
      "provider": "llama.cpp",
      "apiBase": "http://localhost:8080"
